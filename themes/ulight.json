{
    "$schema": "./ulight-theme.schema.json",
    "meta": {
        "name": "ulight",
        "author": "ulight",
        "url": "https://github.com/Eisenwave/ulight"
    },
    "palette": {
        "gray": "#777777",
        "red": "#ff0000",
        "del_text_fg": "#ce9178",
        "ins_text_fg": "#b5cea8",
        "light_fg": "#000000",
        "light_bg": "#f0f0f0",
        "light_green": "#367c2a",
        "light_red": "#c80032",
        "light_dark_green": "#2b5403",
        "light_olive": "#94b500",
        "light_blue": "#1d51a1",
        "light_dark_blue": "#032354",
        "light_purple": "#5c477e",
        "light_magenta": "#853e7a",
        "light_royal_blue": "#0050c8",
        "light_indigo": "#3a2986",
        "light_brown": "#966c1c",
        "light_dim_gray": "#646464",
        "light_diff_del_fg": "#b31d28",
        "light_diff_del_bg": "#ffeef0",
        "light_diff_ins_fg": "#22863a",
        "light_diff_ins_bg": "#f0fff4",
        "light_diff_mod_fg": "#7a680d",
        "light_diff_mod_bg": "#fffdee",
        "dark_bg": "#181818",
        "dark_fg": "#e7e7e7",
        "dark_pink": "#ff5a82",
        "dark_peach": "#cf9e7e",
        "dark_salmon": "#db8d7b",
        "dark_gold": "#edc385",
        "dark_light_blue": "#8cbade",
        "dark_medium_blue": "#669dd9",
        "dark_light_gray": "#cccccc",
        "dark_powder_blue": "#a4c4de",
        "dark_pale_yellow": "#ffdc9c",
        "dark_bright_blue": "#4fb0ff",
        "dark_lavender": "#b0a9cf",
        "dark_pink_magenta": "#ea91d4",
        "dark_white": "#ffffff",
        "dark_dim_gray": "#a0a0a0",
        "dark_green": "#98d48e",
        "dark_diff_del_fg": "#ffdcd7",
        "dark_diff_del_bg": "#67060c",
        "dark_diff_ins_fg": "#aff5b4",
        "dark_diff_ins_bg": "#033a16",
        "dark_diff_mod_fg": "#fff4d7",
        "dark_diff_mod_bg": "#674d06"
    },
    "light": {
        "background": "$light_bg",
        "foreground": "$light_fg",
        "error": "$red",
        "comment": {
            "color": "$gray",
            "font-style": "italic"
        },
        "comment-delim": {
            "font-style": "normal"
        },
        "comment-doc": {
            "color": "$gray",
            "font-style": "italic"
        },
        "comment-doc-delim": {
            "font-style": "normal"
        },
        "value": "$light_green",
        "null": "$light_red",
        "bool": "$light_red",
        "string": "$light_green",
        "string-delim": "$light_dark_green",
        "string-decor": "$light_dark_green",
        "string-escape": "$light_olive",
        "number": "$light_blue",
        "number-delim": "$light_dark_blue",
        "number-decor": "$light_dark_blue",
        "name": "$light_fg",
        "name-var": "$light_purple",
        "name-function": "$light_magenta",
        "name-type": "$light_royal_blue",
        "name-parameter": "$light_purple",
        "name-nonterminal": "$light_purple",
        "name-nonterminal-decl": "$light_red",
        "name-macro": "$light_indigo",
        "name-attr": "$light_brown",
        "name-command": "$light_red",
        "name-option": "$light_purple",
        "name-instruction": "$light_red",
        "name-instruction-pseudo": "$light_olive",
        "keyword": "$light_red",
        "keyword-this": "$light_red",
        "diff-heading": "$gray",
        "diff-heading-hunk": "$light_purple",
        "diff-common": "$light_fg",
        "diff-deletion": {
            "color": "$light_diff_del_fg",
            "background-color": "$light_diff_del_bg"
        },
        "diff-insertion": {
            "color": "$light_diff_ins_fg",
            "background-color": "$light_diff_ins_bg"
        },
        "diff-modification": {
            "color": "$light_diff_mod_fg",
            "background-color": "$light_diff_mod_bg"
        },
        "markup-tag": "$light_red",
        "markup-attr": "$light_purple",
        "text-deletion": {
            "color": "$del_text_fg",
            "text-decoration": "line-through"
        },
        "text-insertion": {
            "color": "$ins_text_fg",
            "text-decoration": "underline"
        },
        "text-emph": {
            "font-style": "italic"
        },
        "text-strong": {
            "font-weight": "bold"
        },
        "text-underline": {
            "text-decoration": "underline"
        },
        "text-strikethrough": {
            "text-decoration": "line-through"
        },
        "symbol": "$light_fg",
        "symbol-punc": "$light_dim_gray",
        "symbol-formatting": "$light_red",
        "text-heading": "$light_red",
        "text-code": "$light_green",
        "text-link": {
            "text-decoration": "underline"
        }
    },
    "dark": {
        "foreground": "$dark_fg",
        "background": "$dark_bg",
        "error": "$red",
        "comment": {
            "color": "$gray",
            "font-style": "italic"
        },
        "comment-delim": {
            "font-style": "normal"
        },
        "comment-doc": {
            "color": "$gray",
            "font-style": "italic"
        },
        "comment-doc-delim": {
            "font-style": "normal"
        },
        "value": "$dark_green",
        "null": "$dark_pink",
        "bool": "$dark_pink",
        "string": "$dark_peach",
        "string-delim": "$dark_salmon",
        "string-decor": "$dark_salmon",
        "string-escape": "$dark_gold",
        "number": "$dark_light_blue",
        "number-delim": "$dark_medium_blue",
        "number-decor": "$dark_medium_blue",
        "name": "$dark_light_gray",
        "name-var": "$dark_powder_blue",
        "name-function": "$dark_pale_yellow",
        "name-type": "$dark_bright_blue",
        "name-parameter": "$dark_powder_blue",
        "name-nonterminal": "$dark_powder_blue",
        "name-nonterminal-decl": "$dark_pink",
        "name-macro": "$dark_lavender",
        "name-attr": "$dark_pink_magenta",
        "name-command": "$dark_pink",
        "name-option": "$dark_powder_blue",
        "name-instruction": "$dark_pink",
        "name-instruction-pseudo": "$dark_gold",
        "keyword": "$dark_pink",
        "keyword-this": "$dark_pink",
        "diff-heading": "$gray",
        "diff-heading-hunk": "$dark_gold",
        "diff-common": "$dark_fg",
        "diff-deletion": {
            "color": "$dark_diff_del_fg",
            "background-color": "$dark_diff_del_bg"
        },
        "diff-insertion": {
            "color": "$dark_diff_ins_fg",
            "background-color": "$dark_diff_ins_bg"
        },
        "diff-modification": {
            "color": "$dark_diff_mod_fg",
            "background-color": "$dark_diff_mod_bg"
        },
        "markup-tag": "$dark_pink",
        "markup-attr": "$dark_powder_blue",
        "text-deletion": {
            "color": "$del_text_fg",
            "text-decoration": "line-through"
        },
        "text-insertion": {
            "color": "$ins_text_fg",
            "text-decoration": "underline"
        },
        "text-emph": {
            "font-style": "italic"
        },
        "text-strong": {
            "font-weight": "bold"
        },
        "text-underline": {
            "text-decoration": "underline"
        },
        "text-strikethrough": {
            "text-decoration": "line-through"
        },
        "symbol": "$dark_white",
        "symbol-punc": "$dark_dim_gray",
        "symbol-formatting": "$dark_pink",
        "text-heading": "$dark_pink",
        "text-code": "$dark_peach",
        "text-link": {
            "text-decoration": "underline"
        }
    }
}
