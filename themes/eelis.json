{
    "$schema": "./ulight-theme.schema.json",
    "meta": {
        "name": "Eeelis",
        "author": "Eelis",
        "url": "https://eel.is/c++draft/14882.css"
    },
    "palette": {
        "black": "#000000",
        "brown": "#9f6807",
        "teal": "#00607c",
        "dark_brown": "#6f4e37",
        "maroon": "#af1915",
        "purple": "#570057",
        "near_black": "#171717",
        "light_gray": "#d0d0d0",
        "lime_green": "#35da00",
        "gold": "#dfa837",
        "cyan": "#12cabe",
        "tan": "#b27c58",
        "muted_purple": "#baa6b9",
        "bright_red": "#ff1515",
        "red": "#ff0000",
        "white": "#ffffff",
        "css_green": "green"
    },
    "light": {
        "background": "$white",
        "foreground": "$black",
        "error": "$red",
        "comment": {
            "color": "$css_green",
            "font-style": "italic"
        },
        "comment-doc": {
            "color": "$css_green",
            "font-style": "italic"
        },
        "comment-delim": {
            "font-style": "normal"
        },
        "comment-doc-delim": {
            "font-style": "normal"
        },
        "value": "$brown",
        "null": "$teal",
        "bool": "$brown",
        "number": "$brown",
        "string": "$brown",
        "string-escape": "$brown",
        "name": "$black",
        "name-macro": "$dark_brown",
        "name-directive": "$dark_brown",
        "keyword": "$teal",
        "keyword-this": "$teal",
        "symbol": "$purple",
        "symbol-punc": "$black",
        "symbol-bracket": "$maroon",
        "symbol-parens": "$maroon",
        "symbol-square": "$maroon",
        "symbol-brace": "$maroon",
        "symbol-formatting": "$teal",
        "text-heading": "$teal",
        "text-code": "$brown",
        "text-link": {
            "text-decoration": "underline"
        }
    },
    "dark": {
        "background": "$near_black",
        "foreground": "$light_gray",
        "error": "$red",
        "comment": {
            "color": "$lime_green",
            "font-style": "italic"
        },
        "comment-delim": {
            "font-style": "normal"
        },
        "comment-doc": {
            "color": "$lime_green",
            "font-style": "italic"
        },
        "comment-doc-delim": {
            "font-style": "normal"
        },
        "value": "$gold",
        "null": "$cyan",
        "bool": "$gold",
        "number": "$gold",
        "string": "$gold",
        "string-escape": "$gold",
        "name": "$light_gray",
        "name-macro": "$tan",
        "keyword": "$cyan",
        "keyword-this": "$cyan",
        "symbol": "$muted_purple",
        "symbol-punc": "$light_gray",
        "symbol-bracket": "$bright_red",
        "symbol-parens": "$bright_red",
        "symbol-square": "$bright_red",
        "symbol-brace": "$bright_red",
        "symbol-formatting": "$cyan",
        "text-heading": "$cyan",
        "text-code": "$gold",
        "text-link": {
            "text-decoration": "underline"
        }
    }
}
