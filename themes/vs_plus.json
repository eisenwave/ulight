{
    "$schema": "./ulight-theme.schema.json",
    "meta": {
        "name": "Visual Studio Plus/Modern",
        "short_name": "VS Plus/Modern",
        "author": "Microsoft",
        "url": "https://github.com/microsoft/vscode/blob/main/extensions/theme-defaults/themes/dark_plus.json",
        "license": "https://github.com/microsoft/vscode/blob/main/LICENSE.txt"
    },
    "palette": {
        "blue": "#569cd6",
        "green": "#6a9955",
        "red": "#f44747",
        "orange": "#ce9178",
        "yellow": "#d7ba7d",
        "purple": "#c586c0",
        "teal": "#4ec9b0",
        "light_blue": "#9cdcfe",
        "medium_blue": "#4fc1ff",
        "pale_yellow": "#dcdcaa",
        "pale_green": "#b5cea8",
        "pink": "#da70d6",
        "fg": "#d4d4d4",
        "bg": "#1e1e1e",
        "gold": "#ffd700",
        "light_gray": "#e7e7e7"
    },
    "dark": {
        "background": "$bg",
        "foreground": "$fg",
        "error": "$red",
        "comment": "$green",
        "value": "$pale_green",
        "null": "$blue",
        "bool": "$blue",
        "number": "$pale_green",
        "string": "$orange",
        "string-escape": "$yellow",
        "string-interpolation": "$pink",
        "name": "$fg",
        "name-var": "$light_blue",
        "name-const": "$medium_blue",
        "name-function": "$pale_yellow",
        "name-type": "$teal",
        "name-label": "$teal",
        "name-lifetime": "$teal",
        "name-parameter": "$light_blue",
        "name-nonterminal": "$medium_blue",
        "name-nonterminal-decl": "$pale_yellow",
        "name-command": "$yellow",
        "name-option": "$blue",
        "name-instruction": "$pale_green",
        "name-macro": "$blue",
        "name-directive": "$blue",
        "keyword": "$blue",
        "keyword-control": "$purple",
        "keyword-op": "$fg",
        "keyword-this": "$blue",
        "diff-heading": "$blue",
        "diff-common": "$light_gray",
        "diff-deletion": "$orange",
        "diff-insertion": "$pale_green",
        "diff-modification": "$blue",
        "markup-tag": "$yellow",
        "markup-attr": "$light_blue",
        "text-deletion": "$orange",
        "text-insertion": "$pale_green",
        "text-emph": {
            "font-style": "italic"
        },
        "text-strong": {
            "color": "$blue",
            "font-weight": "bold"
        },
        "text-underline": {
            "text-decoration": "underline"
        },
        "text-strikethrough": {
            "text-decoration": "line-through"
        },
        "symbol": "$fg",
        "symbol-parens": "$gold",
        "symbol-square": "$gold",
        "symbol-brace": "$gold",
        "symbol-formatting": "$blue",
        "text-heading": "$blue",
        "text-code": "$orange",
        "text-link": {
            "text-decoration": "underline"
        }
    }
}
