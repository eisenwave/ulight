{
    "$schema": "./ulight-theme.schema.json",
    "meta": {
        "name": "ulight",
        "author": "ulight",
        "url": "https://eel.is/c++draft/14882.css"
    },
    "palette": {
        "red": "#ff0000",
        "gray": "#777777",
        "delight_text_fg": "#ce9178",
        "ins_text_fg": "#b5cea8",
        "light_white": "#ffffff",
        "light_black": "#000000",
        "light_css_green": "green",
        "light_brown": "#9f6807",
        "light_teal": "#00607c",
        "light_dark_brown": "#70400c",
        "light_olive": "#517a0b",
        "light_copper": "#6f4e37",
        "light_purple": "#5c477e",
        "light_dark_purple": "#570057",
        "light_maroon": "#af1915",
        "light_diff_delight_fg": "#b31d28",
        "light_diff_delight_bg": "#ffeef0",
        "light_diff_ins_fg": "#22863a",
        "light_diff_ins_bg": "#f0fff4",
        "light_diff_mod_fg": "#7a680d",
        "light_diff_mod_bg": "#fffdee",
        "dark_bg": "#171717",
        "dark_fg": "#f0f0f0",
        "dark_light_green": "#a2e08d",
        "dark_gold": "#f2d18d",
        "dark_cyan": "#62ded6",
        "dark_salmon": "#e6b191",
        "dark_pink": "#e6aee6",
        "dark_lime": "#d8eda6",
        "dark_tan": "#cc946e",
        "dark_muted_purple": "#baa6b9",
        "dark_light_gray": "#d0d0d0",
        "dark_coral": "#fa7878",
        "dark_gold2": "#edc385",
        "dark_fg2": "#e7e7e7",
        "dark_powder_blue": "#a4c4de",
        "dark_diff_delight_fg": "#ffdcd7",
        "dark_diff_delight_bg": "#67060c",
        "dark_diff_ins_fg": "#aff5b4",
        "dark_diff_ins_bg": "#033a16",
        "dark_diff_mod_fg": "#fff4d7",
        "dark_diff_mod_bg": "#674d06"
    },
    "light": {
        "background": "$light_white",
        "foreground": "$light_black",
        "error": "$red",
        "comment": {
            "color": "$light_css_green",
            "font-style": "italic"
        },
        "comment-delim": {
            "font-style": "normal"
        },
        "comment-doc": {
            "color": "$light_css_green",
            "font-style": "italic"
        },
        "comment-doc-delim": {
            "font-style": "normal"
        },
        "value": "$light_brown",
        "null": "$light_teal",
        "bool": "$light_brown",
        "number": "$light_brown",
        "string": "$light_brown",
        "string-escape": "$light_dark_brown",
        "string-interpolation": "$light_dark_brown",
        "name": "$light_black",
        "name-label": "$light_olive",
        "name-lifetime": "$light_olive",
        "name-nonterminal": {
            "font-style": "italic"
        },
        "name-nonterminal-decl": {
            "color": "$light_teal",
            "font-style": "italic"
        },
        "name-command": "$light_teal",
        "name-option": "$light_black",
        "name-instruction": "$light_teal",
        "name-instruction-pseudo": "$light_brown",
        "name-macro": "$light_copper",
        "name-directive": "$light_copper",
        "keyword": "$light_teal",
        "keyword-this": "$light_teal",
        "diff-heading": "$gray",
        "diff-heading-hunk": "$light_purple",
        "diff-common": "$light_black",
        "diff-deletion": {
            "color": "$light_diff_delight_fg",
            "background-color": "$light_diff_delight_bg"
        },
        "diff-insertion": {
            "color": "$light_diff_ins_fg",
            "background-color": "$light_diff_ins_bg"
        },
        "diff-modification": {
            "color": "$light_diff_mod_fg",
            "background-color": "$light_diff_mod_bg"
        },
        "markup-tag": "$light_teal",
        "markup-attr": "$light_purple",
        "text-deletion": {
            "color": "$delight_text_fg",
            "text-decoration": "line-through"
        },
        "text-insertion": {
            "color": "$ins_text_fg",
            "text-decoration": "underline"
        },
        "text-emph": {
            "font-style": "italic"
        },
        "text-strong": {
            "font-weight": "bold"
        },
        "text-underline": {
            "text-decoration": "underline"
        },
        "text-strikethrough": {
            "text-decoration": "line-through"
        },
        "symbol": "$light_dark_purple",
        "symbol-punc": "$light_black",
        "symbol-bracket": "$light_maroon",
        "symbol-parens": "$light_maroon",
        "symbol-square": "$light_maroon",
        "symbol-brace": "$light_maroon",
        "symbol-formatting": "$light_teal",
        "text-heading": "$light_teal",
        "text-code": "$light_brown",
        "text-link": {
            "text-decoration": "underline"
        }
    },
    "dark": {
        "background": "$dark_bg",
        "foreground": "$dark_fg",
        "error": "$red",
        "comment": {
            "color": "$dark_light_green",
            "font-style": "italic"
        },
        "comment-doc": {
            "color": "$dark_light_green",
            "font-style": "italic"
        },
        "comment-delim": {
            "font-style": "normal"
        },
        "comment-doc-delim": {
            "font-style": "normal"
        },
        "value": "$dark_gold",
        "null": "$dark_cyan",
        "bool": "$dark_gold",
        "number": "$dark_gold",
        "number-delim": "$dark_salmon",
        "number-decor": "$dark_salmon",
        "string": "$dark_gold",
        "string-delim": "$dark_salmon",
        "string-decor": "$dark_salmon",
        "string-escape": "$dark_pink",
        "string-interpolation": "$dark_pink",
        "name": "$dark_fg",
        "name-label": "$dark_lime",
        "name-lifetime": "$dark_lime",
        "name-nonterminal": {
            "font-style": "italic"
        },
        "name-nonterminal-decl": {
            "color": "$dark_cyan",
            "font-style": "italic"
        },
        "name-command": "$dark_cyan",
        "name-option": "$dark_fg",
        "name-macro": "$dark_tan",
        "name-directive": "$dark_tan",
        "name-instruction": "$dark_cyan",
        "name-instruction-pseudo": "$dark_pink",
        "keyword": "$dark_cyan",
        "keyword-this": "$dark_cyan",
        "diff-heading": "$gray",
        "diff-heading-hunk": "$dark_gold2",
        "diff-common": "$dark_fg2",
        "diff-deletion": {
            "color": "$dark_diff_delight_fg",
            "background-color": "$dark_diff_delight_bg"
        },
        "diff-insertion": {
            "color": "$dark_diff_ins_fg",
            "background-color": "$dark_diff_ins_bg"
        },
        "diff-modification": {
            "color": "$dark_diff_mod_fg",
            "background-color": "$dark_diff_mod_bg"
        },
        "markup-tag": "$dark_cyan",
        "markup-attr": "$dark_powder_blue",
        "text-deletion": {
            "color": "$delight_text_fg",
            "text-decoration": "line-through"
        },
        "text-insertion": {
            "color": "$ins_text_fg",
            "text-decoration": "underline"
        },
        "text-emph": {
            "font-style": "italic"
        },
        "text-strong": {
            "font-weight": "bold"
        },
        "text-underline": {
            "text-decoration": "underline"
        },
        "text-strikethrough": {
            "text-decoration": "line-through"
        },
        "symbol": "$dark_muted_purple",
        "symbol-punc": "$dark_light_gray",
        "symbol-bracket": "$dark_coral",
        "symbol-parens": "$dark_coral",
        "symbol-square": "$dark_coral",
        "symbol-brace": "$dark_coral",
        "symbol-formatting": "$dark_cyan",
        "text-heading": "$dark_cyan",
        "text-code": "$dark_gold",
        "text-link": {
            "text-decoration": "underline"
        }
    }
}
